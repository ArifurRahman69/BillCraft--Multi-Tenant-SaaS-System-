@model BillCraft.Web.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details - " + Model.InvoiceNumber;
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<!-- Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 d-print-none" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 d-print-none" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Action Buttons / Header -->
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Invoices
        </a>
        <span class="badge @(Model.Status == "Paid" ? "bg-success" : Model.Status == "Partially Paid" ? "bg-warning text-dark" : "bg-danger") px-3 py-2 rounded-pill fs-6">
            @Model.Status
        </span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Paid")
        {
            <button type="button" class="btn btn-success rounded-3" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="bi bi-cash-stack me-1"></i> Record Payment
            </button>
        }
        <button onclick="window.print()" class="btn btn-outline-primary rounded-3">
            <i class="bi bi-printer me-1"></i> Print Invoice
        </button>
        <a asp-action="Create" class="btn btn-primary rounded-3">
            <i class="bi bi-plus-lg me-1"></i> New Invoice
        </a>
    </div>
</div>

<!-- Printable Invoice Card -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-5" id="printableArea">
    <!-- Invoice Top Header -->
    <div class="row align-items-center border-bottom pb-4 mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-receipt me-2"></i>BillCraft</h2>
            <p class="text-muted small mb-0">ইনভয়েস ব্যবস্থাপনা ও ট্র্যাকিং সিস্টেম</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <h4 class="fw-bold text-dark mb-1">INVOICE</h4>
            <span class="text-muted small">#@Model.InvoiceNumber</span>
        </div>
    </div>

    <!-- Client & Invoice Dates Info -->
    <div class="row mb-4">
        <div class="col-md-6">
            <h6 class="text-secondary fw-semibold mb-2">Billed To:</h6>
            <h5 class="fw-bold text-dark mb-1">@Model.Client?.Name</h5>
            <p class="text-muted mb-1"><i class="bi bi-telephone me-2"></i>@(Model.Client?.Phone ?? "N/A")</p>
            <p class="text-muted mb-0"><i class="bi bi-envelope me-2"></i>@(Model.Client?.Email ?? "N/A")</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <div class="mb-2">
                <span class="text-muted me-2">Issue Date:</span>
                <span class="fw-semibold text-dark">@Model.IssueDate.ToString("dd MMM yyyy")</span>
            </div>
            <div>
                <span class="text-muted me-2">Due Date:</span>
                <span class="fw-semibold text-dark">@(Model.DueDate.HasValue? Model.DueDate.Value.ToString("dd MMM yyyy") : "N/A")</span>
            </div>
        </div>
    </div>

    <!-- Invoice Line Items Table -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="bg-light text-secondary">
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 45%;">Item / Description</th>
                    <th style="width: 15%;" class="text-center">Qty</th>
                    <th style="width: 15%;" class="text-end">Unit Price (৳)</th>
                    <th style="width: 20%;" class="text-end">Total (৳)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.InvoiceItems != null && Model.InvoiceItems.Any())
                {
                    int index = 1;
                    foreach (var item in Model.InvoiceItems)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td>
                                <div class="fw-semibold text-dark">@(item.Product?.Name ?? "N/A")</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <small class="text-muted">@item.Description</small>
                                }
                            </td>
                            <td class="text-center fw-semibold">@item.Quantity</td>
                            <td class="text-end">৳@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end fw-semibold">৳@item.Amount.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">কোনো আইটেম পাওয়া যায়নি।</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Payment Summary Row -->
    <div class="row justify-content-end mb-4">
        <div class="col-md-5">
            <div class="bg-light p-3 rounded-3">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Sub Total</span>
                    <span class="fw-semibold text-dark">৳@Model.SubTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tax</span>
                    <span class="fw-semibold text-dark">+ ৳@Model.TaxAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Discount</span>
                    <span class="fw-semibold text-danger">- ৳@Model.DiscountAmount.ToString("N2")</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-6 text-dark">Total Amount</span>
                    <span class="fw-bold fs-6 text-primary">৳@Model.TotalAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">Paid Amount</span>
                    <span class="fw-bold text-success">৳@Model.PaidAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">Due Amount</span>
                    <span class="fw-bold text-danger">৳@Model.DueAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes / Terms -->
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="border-top pt-3 mt-3">
            <h6 class="fw-bold text-secondary mb-1">Notes / Terms:</h6>
            <p class="text-muted small mb-0">@Model.Notes</p>
        </div>
    }
</div>

<!-- Record Payment Modal -->
@if (Model.Status != "Paid")
{
    <div class="modal fade d-print-none" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold" id="paymentModalLabel"><i class="bi bi-cash-stack text-success me-2"></i>Record Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="RecordPayment" method="post">
                    <div class="modal-body">
                        <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />

                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Total Amount</label>
                            <input type="text" class="form-control bg-light" value="৳@Model.TotalAmount.ToString("N2")" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1">Current Due</label>
                            <input type="text" class="form-control bg-light text-danger fw-bold" value="৳@Model.DueAmount.ToString("N2")" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold mb-1">Payment Amount (৳)</label>
                            <input type="number" step="0.01" min="0.01" max="@Model.DueAmount" name="amount" class="form-control" value="@Model.DueAmount" required />
                        </div>
                    </div>
                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success rounded-3 px-4">Save Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Print CSS Styling -->
<style>
    @@media print {
        body * {
            visibility: hidden;
        }

        #printableArea, #printableArea * {
            visibility: visible;
        }

        #printableArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none !important;
            padding: 0 !important;
        }

        .d-print-none {
            display: none !important;
        }
    }
</style>