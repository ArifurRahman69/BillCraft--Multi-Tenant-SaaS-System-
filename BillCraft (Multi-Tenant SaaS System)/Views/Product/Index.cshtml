@model IEnumerable<BillCraft.Web.Models.Product>

@{
    ViewData["Title"] = "Products & Services";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Products & Services</h4>
        <p class="text-muted small mb-0">আপনার সিস্টেমের সকল পণ্য ও সেবা সমূহের তালিকা।</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3 px-3 fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Add New Item
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Item Name</th>
                        <th>Description</th>
                        <th>Unit Price</th>
                        <th>Unit</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">কোনো পণ্য বা সেবা পাওয়া যায়নি। নতুন আইটেম যোগ করুন!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@item.Name</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                <td class="fw-bold text-primary">৳@item.UnitPrice.ToString("N2")</td>
                                <td><span class="badge bg-light text-dark border fw-normal px-2 py-1">@item.Unit</span></td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary rounded-3">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" onsubmit="return confirm('আপনি কি নিশ্চিত যে এই আইটেমটি অপসারন করতে চান?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>