@model BillCraft.Web.Models.Product

@{
    ViewData["Title"] = "Add New Product/Service";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1">Add New Item</h4>
                <p class="text-muted small mb-0">নতুন পণ্য বা সেবার বিবরণ পূরণ করুন।</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary small">Item Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control rounded-3" placeholder="যেমন: Web Development Service" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UnitPrice" class="form-label fw-semibold text-secondary small">Unit Price (BDT) <span class="text-danger">*</span></label>
                        <input asp-for="UnitPrice" type="number" step="0.01" class="form-control rounded-3" placeholder="0.00" />
                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Unit" class="form-label fw-semibold text-secondary small">Unit <span class="text-danger">*</span></label>
                        <input asp-for="Unit" class="form-control rounded-3" placeholder="যেমন: Pcs, Hour, Month, Service" />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-secondary small">Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="পণ্য বা সেবার বিস্তারিত তথ্য..."></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-2 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border rounded-3 px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">Save Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}