@model IEnumerable<BillCraft.Web.Models.ExpenseCategory>

@{
    ViewData["Title"] = "Expense Categories";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-light border rounded-3 btn-sm me-3">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <h4 class="fw-bold mb-0">Expense Categories</h4>
</div>

<div class="row g-4">
    <!-- Add Category Form -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h6 class="fw-bold mb-3">Add New Category</h6>
            <form asp-action="AddCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                    <input name="Name" class="form-control rounded-3" placeholder="e.g. Office Rent, Utility, Salary" required />
                </div>
                <button type="submit" class="btn btn-primary rounded-3 fw-semibold w-100">Save Category</button>
            </form>
        </div>
    </div>

    <!-- Category List Table -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden p-3">
            <h6 class="fw-bold mb-3">Existing Categories</h6>
            <ul class="list-group list-group-flush border-top">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="fw-semibold text-dark">@item.Name</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">কোনো ক্যাটাগরি তৈরি করা নেই।</li>
                }
            </ul>
        </div>
    </div>
</div>