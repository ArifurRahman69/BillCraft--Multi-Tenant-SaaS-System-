@model BillCraft.Web.Models.Expense

@{
    ViewData["Title"] = "Add Expense";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<BillCraft.Web.Models.ExpenseCategory> ?? new List<BillCraft.Web.Models.ExpenseCategory>();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-light border rounded-3 btn-sm me-3">
                <i class="bi bi-arrow-left"></i> Back
            </a>
            <h4 class="fw-bold mb-0">Record New Expense</h4>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ExpenseCategoryId" class="form-label fw-semibold">Expense Category <span class="text-danger">*</span></label>
                        <select asp-for="ExpenseCategoryId" class="form-select rounded-3" asp-items="@(new SelectList(categories, "Id", "Name"))">
                            <option value="">-- Choose Category --</option>
                        </select>
                        <span asp-validation-for="ExpenseCategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label fw-semibold">Amount (BDT) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">৳</span>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control rounded-end-3" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ExpenseDate" class="form-label fw-semibold">Expense Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpenseDate" type="date" class="form-control rounded-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-semibold">Title / Short Note</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. Internet Bill for August" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Additional Details</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="খরচের অতিরিক্ত তথ্য লিখুন..."></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Attach Receipt / Voucher (Optional)</label>
                    <input type="file" name="receiptFile" class="form-control rounded-3" accept="image/*,.pdf" />
                    <small class="text-muted">ছবি (JPG, PNG) অথবা PDF ডকুমেন্ট আপলোড করুন।</small>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-light rounded-3 fw-semibold">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-3 fw-semibold px-4">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}