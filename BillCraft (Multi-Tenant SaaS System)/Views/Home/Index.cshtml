@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Views/Shared/_AdminLayout.cshtml";

    var chartLabelsJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels ?? new List<string>());
    var chartRevenueJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartRevenueData ?? new List<decimal>());
    var chartExpenseJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartExpenseData ?? new List<decimal>());
    var usage = ViewBag.SubscriptionUsage as BillCraft.Web.Models.SubscriptionUsageDto;
}

<!-- Top Header Section -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Dashboard</h4>
        <p class="text-muted small mb-0">আপনার সিস্টেমের সাম্প্রতিক আপডেট ও ওভারভিউ।</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Home")" class="btn btn-white bg-white border shadow-sm rounded-3 fw-semibold text-secondary btn-sm d-flex align-items-center gap-2">
            <i class="bi bi-arrow-clockwise"></i> Refresh Data
        </a>
        <a asp-controller="Invoice" asp-action="Create" class="btn btn-primary rounded-3 fw-semibold btn-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> New Invoice
        </a>
    </div>
</div>

<!-- Subscription Usage Limit Progress Card -->
@if (usage != null)
{
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-speedometer2 fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">সাবস্ক্রিপশন ব্যবহার ও সীমা (<span class="text-primary">@usage.PlanName</span>)</h6>
                    <small class="text-muted">আপনার বর্তমান প্ল্যানের ব্যবহৃত লিমিট</small>
                </div>
            </div>
            <a asp-controller="Subscription" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-3 fw-semibold">
                <i class="bi bi-arrow-up-circle me-1"></i> প্ল্যান আপগ্রেড করুন
            </a>
        </div>
        <div class="row g-3">
            <!-- Clients Progress -->
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light-subtle">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold small">ক্লায়েন্ট লিমিট</span>
                        <small class="fw-bold">
                            @usage.ClientCount / @(usage.MaxClients == -1 ? "∞" : usage.MaxClients)
                        </small>
                    </div>
                    @if (usage.MaxClients != -1)
                    {
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @(usage.ClientUsagePercentage >= 80 ? "bg-danger" : "bg-primary")"
                                 role="progressbar" style="width: @usage.ClientUsagePercentage%"></div>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2">আনলিমিটেড</span>
                    }
                </div>
            </div>

            <!-- Invoices Progress -->
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light-subtle">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold small">চলতি মাসের ইনভয়েস</span>
                        <small class="fw-bold">
                            @usage.InvoiceCountThisMonth / @(usage.MaxInvoicesPerMonth == -1 ? "∞" : usage.MaxInvoicesPerMonth)
                        </small>
                    </div>
                    @if (usage.MaxInvoicesPerMonth != -1)
                    {
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @(usage.InvoiceUsagePercentage >= 80 ? "bg-danger" : "bg-info")"
                                 role="progressbar" style="width: @usage.InvoiceUsagePercentage%"></div>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2">আনলিমিটেড</span>
                    }
                </div>
            </div>

            <!-- Products Progress -->
            <div class="col-md-4">
                <div class="p-3 border rounded-3 bg-light-subtle">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold small">প্রোডাক্টস / সার্ভিসেস</span>
                        <small class="fw-bold">
                            @usage.ProductCount / @(usage.MaxProducts == -1 ? "∞" : usage.MaxProducts)
                        </small>
                    </div>
                    @if (usage.MaxProducts != -1)
                    {
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar @(usage.ProductUsagePercentage >= 80 ? "bg-danger" : "bg-warning")"
                                 role="progressbar" style="width: @usage.ProductUsagePercentage%"></div>
                        </div>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2">আনলিমিটেড</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Financial Summary Status Cards -->
<div class="row g-3 mb-4">
    <!-- Monthly Sales -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Monthly Sales</span>
                    <h3 class="fw-bold mt-2 mb-0">৳ @(((decimal)(ViewBag.MonthlySales ?? 0)).ToString("N2"))</h3>
                    <small class="text-success fw-semibold"><i class="bi bi-graph-up-arrow"></i> Total Revenue</small>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-4">
                    <i class="bi bi-wallet2 fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Expenses -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Monthly Expenses</span>
                    <h3 class="fw-bold text-danger mt-2 mb-0">৳ @(((decimal)(ViewBag.MonthlyExpenses ?? 0)).ToString("N2"))</h3>
                    <small class="text-danger fw-semibold"><i class="bi bi-graph-down-arrow"></i> Total Expense</small>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-4">
                    <i class="bi bi-receipt-cutoff fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Net Profit -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Net Profit</span>
                    <h3 class="fw-bold @(((decimal)(ViewBag.NetProfit ?? 0)) >= 0 ? "text-success" : "text-danger") mt-2 mb-0">
                        ৳ @(((decimal)(ViewBag.NetProfit ?? 0)).ToString("N2"))
                    </h3>
                    <small class="text-muted fw-semibold"><i class="bi bi-calculator"></i> Revenue - Expense</small>
                </div>
                <div class="@(((decimal)(ViewBag.NetProfit ?? 0)) >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") p-3 rounded-4">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Due -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Total Due</span>
                    <h3 class="fw-bold text-warning mt-2 mb-0">৳ @(((decimal)(ViewBag.TotalDue ?? 0)).ToString("N2"))</h3>
                    <small class="text-warning fw-semibold"><i class="bi bi-exclamation-circle"></i> Outstanding</small>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-4">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions & Chart Section -->
<div class="row g-3 mb-4">
    <!-- Quick Action Purple Panel -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-white h-100" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
            <h5 class="fw-bold mb-3">Quick Actions</h5>
            <div class="d-grid gap-2">
                <a asp-controller="Invoice" asp-action="Create" class="btn btn-light text-primary fw-bold text-start p-3 rounded-3 d-flex align-items-center gap-3">
                    <i class="bi bi-plus-circle-fill fs-4"></i> Create New Invoice
                </a>
                <a asp-controller="Expense" asp-action="Create" class="btn btn-outline-light fw-semibold text-start p-3 rounded-3 d-flex align-items-center gap-3 border-0 bg-white bg-opacity-10">
                    <i class="bi bi-receipt fs-4"></i> Record Expense
                </a>
                <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-light fw-semibold text-start p-3 rounded-3 d-flex align-items-center gap-3 border-0 bg-white bg-opacity-10">
                    <i class="bi bi-file-earmark-text fs-4"></i> Invoice History
                </a>
            </div>
        </div>
    </div>

    <!-- Chart Panel -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Financial Overview (Revenue vs Expense)</h6>
                <span class="badge bg-light text-dark border">Last 6 Months</span>
            </div>
            <div style="height: 220px;">
                <canvas id="financialChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tenant Isolation Info Banner -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-primary text-white p-2 rounded-3">
            <i class="bi bi-shield-lock-fill fs-4"></i>
        </div>
        <div>
            <div class="fw-bold text-dark">Multi-Tenant Isolated Session</div>
            <small class="text-muted font-monospace">Active Tenant ID: @(ViewBag.TenantId ?? "N/A")</small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chartLabels = @Html.Raw(chartLabelsJson);
        const chartRevenue = @Html.Raw(chartRevenueJson);
        const chartExpense = @Html.Raw(chartExpenseJson);

        const ctx = document.getElementById('financialChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        label: 'Revenue (BDT)',
                        data: chartRevenue,
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.1)',
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Expense (BDT)',
                        data: chartExpense,
                        borderColor: '#ef4444',
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        fill: true,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top' }
                },
                scales: {
                    y: { grid: { display: false }, beginAtZero: true },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}