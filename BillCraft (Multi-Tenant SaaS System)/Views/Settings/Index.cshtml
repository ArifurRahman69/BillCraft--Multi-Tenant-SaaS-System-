@model BillCraft__Multi_Tenant_SaaS_System_.Models.TenantSettings

@{
    ViewData["Title"] = "Company Settings";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Company Settings</h4>
        <p class="text-muted small mb-0">আপনার প্রতিষ্ঠানের লোগো, ঠিকানা ও ট্যাক্স কনফিগার করুন।</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <form asp-action="Index" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TenantId" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                <input asp-for="CompanyName" class="form-control rounded-3" required />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CompanyEmail" class="form-label fw-semibold"></label>
                <input asp-for="CompanyEmail" type="email" class="form-control rounded-3" />
                <span asp-validation-for="CompanyEmail" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CompanyPhone" class="form-label fw-semibold"></label>
                <input asp-for="CompanyPhone" class="form-control rounded-3" />
            </div>

            <div class="col-md-6">
                <label asp-for="CurrencySymbol" class="form-label fw-semibold"></label>
                <input asp-for="CurrencySymbol" class="form-control rounded-3" placeholder="e.g. ৳ or $" />
            </div>

            <div class="col-md-12">
                <label asp-for="CompanyAddress" class="form-label fw-semibold"></label>
                <textarea asp-for="CompanyAddress" class="form-control rounded-3" rows="2"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="DefaultTaxRate" class="form-label fw-semibold"></label>
                <div class="input-group">
                    <input asp-for="DefaultTaxRate" type="number" step="0.01" class="form-control rounded-3" />
                    <span class="input-group-text">%</span>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Company Logo</label>
                <input type="file" name="logoFile" class="form-control rounded-3" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <div class="mt-2">
                        <img src="@Model.LogoUrl" alt="Logo" class="rounded border p-1" style="max-height: 50px;" />
                    </div>
                }
            </div>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                <i class="bi bi-save me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>